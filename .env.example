# ---- Vercel project environment variables (Settings -> Environment Variables) ----
# Supabase project URL and anon/publishable key. Both are designed to be public; RLS protects the data.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret used to sign Data Handling Receipts (HMAC-SHA256). Long random string. Never commit it.
RECEIPT_SIGNING_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Show the Google button as active once Google is enabled in Supabase Auth (see docs/SETUP_AND_DEPLOY.md).
OAUTH_GOOGLE_ENABLED=false
OAUTH_GITHUB_ENABLED=false
# Guest demo on the login screen. Set to false to require an account.
DEMO_MODE=true
